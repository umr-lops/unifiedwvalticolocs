# Apptainer definition file for unifiedwvalticolocs
# Build (no private registry token needed — s1ifr is now on PyPI):
#   apptainer build unifiedwvalticolocs.sif unifiedwvalticolocs.def
# Run:
#   apptainer run unifiedwvalticolocs.sif
# Shell:
#   apptainer shell unifiedwvalticolocs.sif

Bootstrap: docker
From: python:3.12-slim-bookworm

%arguments
    INSTALL_DEV=false

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PATH=/workspace/.local/bin:$PATH

%setup
    # Runs on the HOST before the container is built.
    # Nothing needed here.


%files
    .                      /workspace

%post
    set -e

    # ---- system deps ----
    apt-get update
    apt-get install -y --no-install-recommends git
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip

    # ---- install project + dependencies ----
    cd /workspace

    if [ "{{ INSTALL_DEV }}" = "true" ]; then
        pip install --no-cache-dir ".[dev]"
    else
        pip install --no-cache-dir .
    fi

    # ---- sanity check ----
    which procunifiedwvalticolocs

%runscript
    # Default command: same as CMD in the Dockerfile
    exec python -m unifiedwvalticolocs "$@"

%test
    # Quick smoke test run after build (optional, remove if slow)
    python -c "import unifiedwvalticolocs; print('import OK')"
    which procunifiedwvalticolocs

%labels
    Maintainer   antoine.grouazel@ifremer.fr
    Version      2026.2.17
    Description  Colocation of S1 WV with CMEMS/CCI altimeter sea-state data

%help
    Apptainer image for the unifiedwvalticolocs Python library.

    Build (production):
        apptainer build \
            unifiedwvalticolocs.sif unifiedwvalticolocs.def

    Build (dev, includes test dependencies):
        apptainer build \
            --build-arg INSTALL_DEV=true \
            unifiedwvalticolocs_dev.sif unifiedwvalticolocs.def

    Run default entrypoint:
        apptainer run unifiedwvalticolocs.sif [args...]

    Run entry-point script directly:
        apptainer exec unifiedwvalticolocs.sif procunifiedwvalticolocs [args...]

    Interactive shell:
        apptainer shell unifiedwvalticolocs.sif
